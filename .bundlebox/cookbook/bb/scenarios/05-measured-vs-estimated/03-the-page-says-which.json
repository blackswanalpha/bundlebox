{
 "id": "measured-page",
 "surface": "measured-vs-estimated",
 "severity": "medium",
 "title": "the console answers, and labels the measured half",
 "question": "does the running dashboard serve state, and does that state carry its own label?",
 "rule": [
  "The console is read-only, on loopback, and nothing on the page calls a model."
 ],
 "steps": [
  {
   "name": "health says what it is",
   "do": "GET /health",
   "expect": {
    "status": 200,
    "json": {
     "ok": true,
     "service": "bundlebox-console"
    },
    "max_ms": 2000
   }
  },
  {
   "name": "the bench endpoint carries its kind",
   "do": "GET /api/bench",
   "expect": {
    "status": 200,
    "json": {
     "kind": "MEASURED"
    },
    "json_present": [
     "saved_pct",
     "bare",
     "packed"
    ]
   }
  },
  {
   "name": "the state endpoint knows the workspace",
   "do": "GET /api/state",
   "expect": {
    "status": 200,
    "json_present": [
     "pipeline",
     "findings",
     "bench",
     "saved"
    ]
   }
  },
  {
   "name": "there is no write route",
   "do": "GET /api/nope",
   "expect": {
    "status": 404
   }
  }
 ]
}